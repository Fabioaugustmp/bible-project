# Copie para .env (fica fora do git) e preencha. Ver DEPLOY.md, seção "Publicação".

# Endereço público da aplicação (com https). Vazio = uso só local, sem código.
BIBLE_PUBLIC_ORIGIN=https://biblia.famptech.com.br

# Código de acesso: pelo menos 16 caracteres. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
BIBLE_ACCESS_TOKEN=

