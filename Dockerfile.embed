# Busca por sentido (app/embed_service.py): BGE-M3 em CPU, vetores de data/embeddings.db.
# Opcional: só sobe com o perfil "semantic" (docker compose --profile semantic up).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    BIBLE_DATA_DIR=/data \
    BIBLE_EMBED_HOST=0.0.0.0 \
    BIBLE_EMBED_PORT=8378

# Versões de .venv-bench (pip freeze): torch 2.11.0 (build CPU, sem CUDA), sentence-transformers 6.3.0, numpy 2.5.5.
RUN pip install --no-cache-dir --retries 10 --timeout 120 torch==2.11.0 --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir --retries 10 --timeout 120 sentence-transformers==6.3.0 numpy==2.5.5

RUN useradd --create-home --uid 1000 app \
 && mkdir /data && chown app /data

WORKDIR /app
COPY app/embed_service.py ./app/embed_service.py

USER app
EXPOSE 8378

CMD ["python", "app/embed_service.py"]
